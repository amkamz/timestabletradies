; Times Table Tradies — the Godot rendering layer.
;
; This project is a *renderer, not a client*. It holds no session, makes no
; network calls and has no Supabase SDK in it. The Compose/SwiftUI shell hands
; it JSON and takes JSON back — see docs/native/rescope.md.
;
; Mobile renderer, because the target device is a low-end Android tablet.

config_version=5

[application]

config/name="Times Table Tradies"
config/description="City, characters and games. Embedded in the native shell."
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/main_scene="res://scenes/city/city_editor.tscn"

[display]

; Lets the render view be created translucent. Half of the transparency story.
;
; The other half is the SurfaceView's z-order, and it is the half that decides
; *what* the alpha blends against. A SurfaceView sits **below** the window by
; default, so its transparent pixels reveal the window background — black — and
; not the Compose content, which is drawn above it. `setZOrderOnTop(true)` lifts
; it above the window instead, where alpha blends with what Compose has drawn.
;
; That is why transparency is per-screen rather than global: on top, the surface
; also covers every Compose control over it. The Site tile has nothing above it
; and is transparent; the city editor has a back button and a build panel over
; it and stays opaque. `city_editor.gd` reads which it is from the state the
; shell sends.
window/per_pixel_transparency/allowed=true

; The engine calls setRequestedOrientation on the host activity when it starts,
; and its handheld default is landscape — so embedding it rotated the whole app,
; Compose screens included, and the rotation then recreated the activity and
; threw away every bit of navigation state with it.
;
; **This is an int, not a string.** Godot 4 stores it as a DisplayServer
; ScreenOrientation enum: 0 landscape, 1 portrait. Writing "portrait" here
; parses as nothing and silently leaves the default in place, which is exactly
; what happened the first time.
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[physics]

common/enable_pause_aware_picking=true
