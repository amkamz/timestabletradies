; Times Table Tradies — the Godot rendering layer.
;
; This project is a *renderer, not a client*. It holds no session, makes no
; network calls and has no Supabase SDK in it. The Compose/SwiftUI shell hands
; it JSON and takes JSON back — see docs/native/rescope.md.
;
; Mobile renderer, because the target device is a low-end Android tablet.

config_version=5

[application]

config/name="Times Table Tradies"
config/description="City, characters and games. Embedded in the native shell."
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/main_scene="res://scenes/city/city_editor.tscn"

[display]

; NOT enabled, and here is what happens if you turn it on.
;
; The city sits inside a painted landscape on the Site screen, so its surface
; ought to be transparent. Setting `window/per_pixel_transparency/allowed=true`
; does flip the engine's own flag — the log goes from "Render view should be
; transparent: false" to "true" — but the result on a device is a **solid black
; rectangle**, whether the environment clears to a colour or to zero alpha. The
; SurfaceView goes translucent and then composites against black rather than
; against the Compose content behind it.
;
; The rest of that fix is the surface's pixel format and z-order, which is a
; real change rather than a flag. Until then the city clears to Toolbox Pop's
; sky, which blends with the screen's own sky well enough to live with.

; The engine calls setRequestedOrientation on the host activity when it starts,
; and its handheld default is landscape — so embedding it rotated the whole app,
; Compose screens included, and the rotation then recreated the activity and
; threw away every bit of navigation state with it.
;
; **This is an int, not a string.** Godot 4 stores it as a DisplayServer
; ScreenOrientation enum: 0 landscape, 1 portrait. Writing "portrait" here
; parses as nothing and silently leaves the default in place, which is exactly
; what happened the first time.
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[physics]

common/enable_pause_aware_picking=true
